# =========================================================================
# Terraform Local Files and Directories
# =========================================================================

# Ignore the local hidden directory where Terraform downloads providers and modules
.terraform/

# Ignore local state files which contain infrastructure metadata and raw values
*.tfstate
*.tfstate.*

# Ignore crash logs or temporary execution states
crash.log
crash.*.*

# Ignore override files used for local testing tweaks
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files generated locally
.terraformrc
terraform.rc

.terraform.lock.hcl
# =========================================================================
# Variable Files (Contains sensitive parameters)
# =========================================================================

# Ignore any files meant to store deployment credentials or private user configurations
*.tfvars
*.tfvars.json

# =========================================================================
# Operating System & IDE Specific Files
# =========================================================================
.DS_Store
.idea/
.vscode/
*.swp
